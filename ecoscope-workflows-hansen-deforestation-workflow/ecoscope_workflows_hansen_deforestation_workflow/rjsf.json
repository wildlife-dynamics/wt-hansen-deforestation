          "ecoscope:advanced": true,
          "title": "Posterior Draws",
          "type": "integer"
        },
        "tune": {
          "default": null,
          "description": "Number of MCMC tuning steps. Leave empty to default to the same value as Posterior Draws.",
          "ecoscope:advanced": true,
          "title": "MCMC Tuning Steps",
          "type": [
            "integer",
            "null"
          ]
        },
        "chains": {
          "default": 2,
