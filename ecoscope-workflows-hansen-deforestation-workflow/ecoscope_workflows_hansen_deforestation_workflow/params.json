        }
      },
      "title": "GammSplineSettings",
      "type": "object"
    },
    "GammTrendModel": {
      "description": "Bayesian generalized additive mixed model with per-site random\neffects. A workflow fits this once across every site's combined data\n(site_ids derived automatically from a \"name\" column if present - see\nfit_trend_model), then predicts each site's own group-specific curve\nfrom that shared fit (see predict_trend_model's `dataframe` parameter) -\nunlike the other three models, which each fit and predict independently\nper site. Mainly useful here for its Bayesian credible intervals rather\nthan frequentist confidence intervals, at the added cost of MCMC\nsampling - both fitting and (since a fitted estimator can't cross a task\nboundary) every downstream prediction refit this model from scratch,\nmaking it substantially slower than the other three.",
      "properties": {
        "model": {
          "const": "gamm",
          "default": "gamm",
          "enum": [
            "gamm"
          ],
          "title": "Model",
          "type": "string"
        },
        "family_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammFamilySettings"
            }
          ],
          "default": {
            "family": "gaussian"
          },
          "ecoscope:advanced": true,
          "title": "Distribution Family"
        },
        "spline_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammSplineSettings"
            }
          ],
          "default": {
            "degree_of_freedom": 10
          },
          "ecoscope:advanced": true,
          "title": "Spline Shape"
        },
        "mcmc_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammMcmcSettings"
            }
          ],
          "default": {
            "inference_method": "mcmc",
            "draws": 500,
            "tune": null,
            "chains": 2,
            "random_seed": null
          },
          "ecoscope:advanced": true,
          "title": "MCMC Sampling"
        }
      },
      "title": "Generalized Additive Mixed Model (GAMM)",
      "type": "object"
    },
    "GlmFamilySettings": {
      "properties": {
        "family": {
          "default": "gaussian",
          "description": "Distribution assumed for the response variable.",
          "ecoscope:advanced": true,
          "oneOf": [
