{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Set Workflow Details"
    },
    "gee_project_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/GoogleEarthEngineConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to Earth Engine"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "Start year of the analysis. The Hansen dataset baseline always starts from 2000.",
          "default": "2000-01-01T00:00:00.000Z"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "End year of the analysis. Depends on the Hansen dataset selected (e.g. UMD/hansen/global_forest_change_2024_v1_12 covers up to 2024)."
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "hansen_image": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "",
          "type": "string",
          "default": "UMD/hansen/global_forest_change_2024_v1_12",
          "description": "Hansen Global Forest Change dataset image name."
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "Hansen Dataset"
    },
    "groupers": {
      "additionalProperties": false,
      "properties": {
        "groupers": {
          "default": [
            {
              "index_name": "name"
            }
          ],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ValueGrouper"
              }
            ],
            "title": "Group by"
          },
          "title": " ",
          "type": "array",
          "description": "            Specify how the data should be grouped to create the views for your dashboard.\n            This field is optional; if left blank, all the data will appear in a single view.\n            "
        }
      },
      "type": "object",
      "required": [],
      "title": "Set Groupers"
    },
    "roi": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalFileSpatialFeatures"
            },
            {
              "$ref": "#/$defs/RemoteFileSpatialFeatures"
            }
          ],
          "title": "Spatial Feature Data Source"
        }
      },
      "required": [
        "config"
      ],
      "type": "object",
      "title": "Load Region of Interest"
    },
    "Forest Analysis": {
      "type": "object",
      "description": "",
      "ecoscope:task_group": true,
      "properties": {
        "tree_cover_threshold": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Tree Cover Threshold",
              "type": "number",
              "default": 60.0,
              "description": "Minimum tree cover percentage (0-100) to classify a pixel as forest.",
              "minimum": 0.0,
              "maximum": 100.0
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        },
        "forest_cover_trends": {
          "additionalProperties": false,
          "properties": {
            "scale": {
              "default": 30,
              "title": "Scale",
              "type": "integer",
              "description": "Pixel scale in meters for reduction",
              "ecoscope:advanced": true
            },
            "max_pixels": {
              "default": 1000000000.0,
              "title": "Max Pixels",
              "type": "number",
              "description": "Maximum pixels for reduction",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "base_map_defs": {
      "additionalProperties": false,
      "properties": {
        "base_maps": {
          "default": [
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
              "opacity": 1,
              "max_zoom": 20,
              "min_zoom": 0
            },
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
              "opacity": 0.5,
              "max_zoom": 20,
              "min_zoom": 0
            }
          ],
          "items": {
            "title": "Base Layer",
            "anyOf": [
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "enum": [
                      "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Open Street Map",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Roadmap",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Satellite",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Terrain",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "USGS Hillshade",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://example.tiles.com/{z}/{x}/{y}.png",
                    "description": "The URL of a publicly accessible tiled raster service.",
                    "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}([-a-zA-Z0-9()@:%_\\+.~#?&//=\\{\\}]*)",
                    "title": "Custom Layer URL",
                    "type": "string"
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Custom Layer Opacity",
                    "type": "number"
                  },
                  "max_zoom": {
                    "default": 20,
                    "description": "Set the maximum zoom level to fetch tiles for.",
                    "title": "Custom Layer Max Zoom",
                    "type": "integer"
                  },
                  "min_zoom": {
                    "default": 0,
                    "description": "Set the minimum zoom level to fetch tiles for.",
                    "title": "Custom Layer Min Zoom",
                    "type": "integer"
                  }
                },
                "title": "Custom Layer (Advanced)",
                "type": "object"
              }
            ]
          },
          "title": " ",
          "type": "array",
          "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Base Maps"
    },
    "roi_layer": {
      "additionalProperties": false,
      "properties": {
        "tooltip_columns": {
          "default": null,
          "items": {
            "type": "string"
          },
          "title": "Tooltip Columns",
          "type": "array",
          "description": "Restrict the on-hover tooltip to these column names. None (default) shows all properties.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": ""
    },
    "Trend Analysis": {
      "type": "object",
      "description": "Choose a trend model and configure its fitting parameters.",
      "ecoscope:task_group": true,
      "properties": {
        "trend_model": {
          "additionalProperties": false,
          "properties": {
            "model": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LinearTrendModel"
                },
                {
                  "$ref": "#/$defs/GlmTrendModel"
                },
                {
                  "$ref": "#/$defs/GamTrendModel"
                },
                {
                  "$ref": "#/$defs/GammTrendModel"
                }
              ],
              "default": {
                "model": "gam",
                "family_settings": {
                  "family": "gaussian"
                },
                "smoothing_settings": {
                  "alpha": null,
                  "metric": "aic"
                },
                "spline_settings": {
                  "degree": 3,
                  "degree_of_freedom": 6
                }
              },
              "title": "Model"
            }
          },
          "type": "object",
          "required": [],
          "title": ""
        }
      }
    },
    "Dashboard": {
      "type": "object",
      "description": "Configure the dashboard output titles.",
      "ecoscope:task_group": true,
      "properties": {
        "map_widget_title": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Map Title",
              "type": "string",
              "default": "Forest Change Map",
              "description": "Title displayed on the forest change map."
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        },
        "chart_widget_title": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Trend Chart Title",
              "type": "string",
              "default": "Forest Cover Trend Chart",
              "description": "Title displayed on the forest cover trend chart."
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        }
      }
    }
  },
  "$defs": {
    "GoogleEarthEngineConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "GoogleEarthEngineConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "SpatialGrouper": {
      "properties": {
        "spatial_index_name": {
          "title": "Spatial Regions",
          "type": "string"
        }
      },
      "required": [
        "spatial_index_name"
      ],
      "title": "Spatial",
      "type": "object"
    },
    "TemporalGrouper": {
      "properties": {
        "temporal_index": {
          "oneOf": [
            {
              "const": "%Y",
              "title": "Year (example: 2024)"
            },
            {
              "const": "%B",
              "title": "Month (example: September)"
            },
            {
              "const": "%Y-%m",
              "title": "Year and Month (example: 2023-01)"
            },
            {
              "const": "%j",
              "title": "Day of the year as a number (example: 365)"
            },
            {
              "const": "%d",
              "title": "Day of the month as a number (example: 31)"
            },
            {
              "const": "%A",
              "title": "Day of the week (example: Sunday)"
            },
            {
              "const": "%H",
              "title": "Hour (24-hour clock) as number (example: 22)"
            },
            {
              "const": "%Y-%m-%d",
              "title": "Date (example: 2025-01-31)"
            }
          ],
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "temporal_index"
      ],
      "title": "Time",
      "type": "object"
    },
    "ValueGrouper": {
      "properties": {
        "index_name": {
          "title": "Category",
          "type": "string",
          "oneOf": [
            {
              "const": "name",
              "title": "Region of Interest"
            }
          ]
        }
      },
      "required": [
        "index_name"
      ],
      "title": "Category",
      "type": "object"
    },
    "EarthRangerSpatialFeatures": {
      "properties": {
        "data_source": {
          "description": "Select one of your configured EarthRanger data sources.",
          "title": "Data Source",
          "type": "string"
        },
        "spatial_features_group_name": {
          "description": "Name of the spatial features group in EarthRanger",
          "title": "Spatial Features Group Name",
          "type": "string"
        }
      },
      "required": [
        "data_source",
        "spatial_features_group_name"
      ],
      "title": "EarthRanger",
      "type": "object"
    },
    "LocalFileSpatialFeatures": {
      "properties": {
        "file_path": {
          "description": "Path to geoparquet (.parquet) or geopackage (.gpkg) file",
          "title": "File Path",
          "type": "string",
          "default": ""
        },
        "name_column": {
          "description": "Column to use as region name",
          "title": "Name Column",
          "type": "string",
          "default": "name"
        },
        "layer": {
          "default": null,
          "description": "Layer name (only applicable to geopackage files)",
          "ecoscope:advanced": true,
          "title": "Layer",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "file_path",
        "name_column"
      ],
      "title": "Local File",
      "type": "object"
    },
    "RemoteFileSpatialFeatures": {
      "properties": {
        "url": {
          "description": "URL to geoparquet (.parquet) or geopackage (.gpkg) file",
          "title": "Url",
          "type": "string",
          "default": ""
        },
        "name_column": {
          "description": "Column to use as region name",
          "title": "Name Column",
          "type": "string",
          "default": "name"
        },
        "layer": {
          "default": null,
          "description": "Layer name (only applicable for geopackage files)",
          "ecoscope:advanced": true,
          "title": "Layer",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "url",
        "name_column"
      ],
      "title": "Remote URL",
      "type": "object"
    },
    "AddInterceptSettings": {
      "properties": {
        "add_intercept": {
          "default": true,
          "description": "Whether to fit a y-intercept term. Disable to force the line through the origin.",
          "ecoscope:advanced": true,
          "title": "Add Intercept",
          "type": "boolean"
        }
      },
      "title": "AddInterceptSettings",
      "type": "object"
    },
    "GamFamilySettings": {
      "properties": {
        "family": {
          "default": "gaussian",
          "description": "Distribution assumed for the response variable.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "gaussian",
              "title": "Gaussian"
            },
            {
              "const": "poisson",
              "title": "Poisson"
            },
            {
              "const": "binomial",
              "title": "Binomial"
            }
          ],
          "title": "Distribution Family",
          "type": "string"
        }
      },
      "title": "GamFamilySettings",
      "type": "object"
    },
    "GamSmoothingSettings": {
      "properties": {
        "alpha": {
          "default": null,
          "description": "Fixed smoothing strength. Leave empty to select automatically via cross-validation.",
          "ecoscope:advanced": true,
          "title": "Smoothing Parameter (Alpha)",
          "type": [
            "number",
            "null"
          ]
        },
        "metric": {
          "default": "aic",
          "description": "Used only when Alpha is left empty.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "aic",
              "title": "AIC"
            },
            {
              "const": "bic",
              "title": "BIC"
            },
            {
              "const": "euclidean",
              "title": "Euclidean Distance"
            },
            {
              "const": "mse",
              "title": "MSE"
            },
            {
              "const": "r_squared",
              "title": "R-Squared"
            }
          ],
          "title": "Alpha Selection Metric",
          "type": "string"
        }
      },
      "title": "GamSmoothingSettings",
      "type": "object"
    },
    "GamSplineSettings": {
      "properties": {
        "degree_of_freedom": {
          "default": 6,
          "description": "Number of basis functions for the spline. Higher values allow more flexible curves but risk overfitting.",
          "ecoscope:advanced": true,
          "title": "Spline Degrees of Freedom",
          "type": "integer"
        },
        "degree": {
          "default": 3,
          "description": "Polynomial degree of each spline segment (3 = cubic).",
          "ecoscope:advanced": true,
          "title": "Spline Degree",
          "type": "integer"
        }
      },
      "title": "GamSplineSettings",
      "type": "object"
    },
    "GamTrendModel": {
      "description": "Generalized additive model via B-splines. Smooths the trend rather\nthan fitting a straight line; the recommended default for most trend\ncharts.",
      "properties": {
        "model": {
          "const": "gam",
          "default": "gam",
          "enum": [
            "gam"
          ],
          "title": "Model",
          "type": "string"
        },
        "family_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GamFamilySettings"
            }
          ],
          "default": {
            "family": "gaussian"
          },
          "ecoscope:advanced": true,
          "title": "Distribution Family"
        },
        "smoothing_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GamSmoothingSettings"
            }
          ],
          "default": {
            "alpha": null,
            "metric": "aic"
          },
          "ecoscope:advanced": true,
          "title": "Smoothing"
        },
        "spline_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GamSplineSettings"
            }
          ],
          "default": {
            "degree_of_freedom": 6,
            "degree": 3
          },
          "ecoscope:advanced": true,
          "title": "Spline Shape"
        }
      },
      "title": "Generalized Additive Model (GAM)",
      "type": "object"
    },
    "GammFamilySettings": {
      "properties": {
        "family": {
          "default": "gaussian",
          "description": "Distribution assumed for the response variable.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "gaussian",
              "title": "Gaussian"
            },
            {
              "const": "poisson",
              "title": "Poisson"
            },
            {
              "const": "gamma",
              "title": "Gamma"
            },
            {
              "const": "bernoulli",
              "title": "Bernoulli"
            }
          ],
          "title": "Distribution Family",
          "type": "string"
        }
      },
      "title": "GammFamilySettings",
      "type": "object"
    },
    "GammMcmcSettings": {
      "properties": {
        "inference_method": {
          "default": "mcmc",
          "description": "MCMC is the reliable default for models with random effects; Laplace is faster when it converges but may fail for some model specifications.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "mcmc",
              "title": "MCMC"
            },
            {
              "const": "laplace",
              "title": "Laplace"
            }
          ],
          "title": "Inference Method",
          "type": "string"
        },
        "draws": {
          "default": 500,
