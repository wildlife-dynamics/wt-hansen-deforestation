          "title": "MCMC Chains",
          "type": "integer"
        },
        "random_seed": {
          "default": null,
          "description": "Seed for the MCMC sampler. Leave empty for a non-deterministic fit.",
          "ecoscope:advanced": true,
          "title": "Random Seed",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "title": "GammMcmcSettings",
      "type": "object"
    },
    "GammSplineSettings": {
      "properties": {
        "degree_of_freedom": {
          "default": 10,
          "description": "Number of basis functions for the spline. Higher values allow more flexible curves but risk overfitting.",
          "ecoscope:advanced": true,
          "title": "Spline Degrees of Freedom",
          "type": "integer"
        }
      },
      "title": "GammSplineSettings",
      "type": "object"
    },
    "GammTrendModel": {
      "description": "Bayesian generalized additive mixed model with per-site random\neffects. A workflow fits this once across every site's combined data\n(site_ids derived automatically from a \"name\" column if present - see\nfit_trend_model), then predicts each site's own group-specific curve\nfrom that shared fit (see predict_trend_model's `dataframe` parameter) -\nunlike the other three models, which each fit and predict independently\nper site. Mainly useful here for its Bayesian credible intervals rather\nthan frequentist confidence intervals, at the added cost of MCMC\nsampling - both fitting and (since a fitted estimator can't cross a task\nboundary) every downstream prediction refit this model from scratch,\nmaking it substantially slower than the other three.",
      "properties": {
        "model": {
          "const": "gamm",
          "default": "gamm",
          "enum": [
            "gamm"
          ],
          "title": "Model",
          "type": "string"
        },
        "family_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammFamilySettings"
            }
          ],
          "default": {
            "family": "gaussian"
          },
          "ecoscope:advanced": true,
          "title": "Distribution Family"
        },
        "spline_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammSplineSettings"
            }
          ],
          "default": {
            "degree_of_freedom": 10
          },
          "ecoscope:advanced": true,
          "title": "Spline Shape"
        },
        "mcmc_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GammMcmcSettings"
            }
          ],
          "default": {
            "inference_method": "mcmc",
            "draws": 500,
            "tune": null,
            "chains": 2,
            "random_seed": null
          },
          "ecoscope:advanced": true,
          "title": "MCMC Sampling"
        }
      },
      "title": "Generalized Additive Mixed Model (GAMM)",
      "type": "object"
    },
    "GlmFamilySettings": {
      "properties": {
        "family": {
          "default": "gaussian",
          "description": "Distribution assumed for the response variable.",
          "ecoscope:advanced": true,
          "oneOf": [
            {
              "const": "gaussian",
              "title": "Gaussian"
            },
            {
              "const": "poisson",
              "title": "Poisson"
            },
            {
              "const": "binomial",
              "title": "Binomial"
            },
            {
              "const": "gamma",
              "title": "Gamma"
            }
          ],
          "title": "Distribution Family",
          "type": "string"
        }
      },
      "title": "GlmFamilySettings",
      "type": "object"
    },
    "GlmTrendModel": {
      "description": "Generalized linear model. Baseline for comparison against the smoothed\nmodels below - not recommended as the final trend line.",
      "properties": {
        "model": {
          "const": "glm",
          "default": "glm",
          "enum": [
            "glm"
          ],
          "title": "Model",
          "type": "string"
        },
        "family_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/GlmFamilySettings"
            }
          ],
          "default": {
            "family": "gaussian"
          },
          "ecoscope:advanced": true,
          "title": "Distribution Family"
        },
        "intercept_settings": {
          "allOf": [
            {
              "$ref": "#/$defs/AddInterceptSettings"
            }
          ],
          "default": {
            "add_intercept": true
          },
          "ecoscope:advanced": true,
          "title": "Add Intercept"
        }
      },
      "title": "Generalized Linear Model (GLM)",
      "type": "object"
    },
    "LinearTrendModel": {
      "description": "Ordinary least squares. No smoothing - a single straight-line trend.",
      "properties": {
        "model": {
          "const": "linear",
          "default": "linear",
          "enum": [
